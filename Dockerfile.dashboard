# arm64 (t4g.micro K3s)
FROM --platform=linux/arm64 python:3.11-slim

WORKDIR /app

# 의존성만 먼저 설치 (레이어 캐시 활용)
COPY pyproject.toml .
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29" "psycopg2-binary==2.9.9" "jinja2>=3.0"

COPY src/ src/

ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uvicorn", "infrapilot.dashboard.main:app", "--host", "0.0.0.0", "--port", "8000"]
