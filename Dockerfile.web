# InfraPilot 웹 + 스캐너 공용 이미지 (linux/arm64 → t4g.micro Graviton)
# 같은 이미지를 Deployment(uvicorn)와 CronJob(scripts/scanner_job.py)이 command만 바꿔 쓴다.

# ── 1단계: 빌드 (컴파일러·pip 캐시는 여기 두고 최종 이미지엔 venv만 가져감) ──
FROM python:3.12-slim AS builder
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# 의존성 먼저 설치 → 코드만 바뀐 커밋은 이 레이어를 캐시에서 재사용(CI 빌드 시간 단축)
COPY pyproject.toml .
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > requirements.txt \
 && pip install -r requirements.txt

COPY infrapilot/ infrapilot/
RUN pip install --no-deps .

# ── 2단계: 런타임 ──
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/opt/venv/bin:$PATH" REDIS_HOST=redis

COPY --from=builder /opt/venv /opt/venv
COPY scripts/scanner_job.py ./scripts/scanner_job.py

# non-root 실행 (k3s 매니페스트의 runAsNonRoot/runAsUser: 1000 과 짝)
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER 1000

EXPOSE 8000
CMD ["uvicorn", "infrapilot.dashboard.main:app", "--host", "0.0.0.0", "--port", "8000"]
